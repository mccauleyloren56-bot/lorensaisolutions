app.get("/v1/site-intel", async (c) => {
  const domainParam = c.req.query("domain");
  if (!domainParam) {
    return c.json({ error: "MISSING_DOMAIN", usage: "/v1/site-intel?domain=example.com" }, 400);
  }
  const domain = domainParam
    .toLowerCase()
    .replace(/^https?:\/\//, "")
    .replace(/\/.*$/, "");
  const raw = await c.env.STATE.get(`intel:${domain}`, "json");
  if (!raw) {
    return c.json({
      domain,
      known: false,
      total_checks: 0,
      message: "No agent-preflight history for this domain yet. Run a check on it first.",
    });
  }
  return c.json({ ...(raw as Record<string, unknown>), known: true });
});

