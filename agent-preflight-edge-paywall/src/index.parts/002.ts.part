app.post("/mcp", async (c) => {
  const parsed = mcpRequestSchema.safeParse(await c.req.json().catch(() => null));
  if (!parsed.success) {
    return c.json(mcpError(null, -32600, "Invalid JSON-RPC request"), 400);
  }

  const { id = null, method, params = {} } = parsed.data;
  if (method === "initialize") {
    return c.json({
      jsonrpc: "2.0",
      id,
      result: {
        protocolVersion: "2025-06-18",
        capabilities: { tools: { listChanged: false } },
        serverInfo: { name: "agent-preflight-edge-paywall", version: SERVICE.version },
      },
    });
  }
  if (method === "notifications/initialized") {
    return c.body(null, 204);
  }
  if (method === "tools/list") {
    return c.json({ jsonrpc: "2.0", id, result: { tools: mcpTools() } });
  }
  if (method !== "tools/call") {
    return c.json(mcpError(id, -32601, "Method not found"), 404);
  }

  const name = typeof params.name === "string" ? params.name : "";
  const route = routeById(name);
  if (!route) {
    return c.json(mcpError(id, -32602, "Unknown tool"), 400);
  }
  const args =
    params.arguments && typeof params.arguments === "object"
      ? params.arguments as Record<string, unknown>
      : {};
  const targetRequest = buildMcpToolRequest(c, route, args);
  if (targetRequest instanceof Response) return targetRequest;

  const paidResponse = await app.fetch(targetRequest, c.env, c.executionCtx);
  const body = await paidResponse.text();
  const headers = new Headers({ "Content-Type": "application/json" });
  const paymentRequired = paidResponse.headers.get("PAYMENT-REQUIRED");
  const paymentResponse = paidResponse.headers.get("PAYMENT-RESPONSE");
  if (paymentRequired) headers.set("PAYMENT-REQUIRED", paymentRequired);
  if (paymentResponse) headers.set("PAYMENT-RESPONSE", paymentResponse);

  if (paidResponse.status === 402) {
    return new Response(body, { status: 402, headers });
  }

  const resultBody = safeJson(body);
  return new Response(
    JSON.stringify({
      jsonrpc: "2.0",
      id,
      result: {
        content: [{ type: "text", text: JSON.stringify(resultBody) }],
        structuredContent: resultBody,
        isError: paidResponse.status >= 400,
      },
    }),
    { status: paidResponse.status, headers },
  );
});

app.post("/mcp/tools/call", async (c) => {
  const body = await c.req.json().catch(() => null);
  const wrappedRequest = new Request(`${SERVICE.baseUrl}/mcp`, {
    method: "POST",
    headers: c.req.raw.headers,
    body: JSON.stringify({
      jsonrpc: "2.0",
      id: crypto.randomUUID(),
      method: "tools/call",
      params: body,
    }),
  });
  return app.fetch(wrappedRequest, c.env, c.executionCtx);
});

async function recordSiteIntel(
  c: Context<AppEnv>,
  url: string,
  result: PreflightResult,
): Promise<void> {
  const domain = new URL(url).hostname;
  const key = `intel:${domain}`;
  const raw = await c.env.STATE.get(key, "json") as
    | {
        domain: string;
        total_checks: number;
        captcha_count: number;
        bot_challenge_count: number;
        paywall_count: number;
        login_count: number;
      }
    | null;
  const existing = raw ?? {
    domain,
    total_checks: 0,
    captcha_count: 0,
    bot_challenge_count: 0,
    paywall_count: 0,
    login_count: 0,
  };
  const updated = {
    domain,
    total_checks: existing.total_checks + 1,
    captcha_count: existing.captcha_count + (result.checks.captcha ? 1 : 0),
    bot_challenge_count: existing.bot_challenge_count + (result.checks.bot_challenge ? 1 : 0),
    paywall_count: existing.paywall_count + (result.checks.paywall ? 1 : 0),
    login_count: existing.login_count + (result.checks.login ? 1 : 0),
    last_status: result.status,
    last_risk: result.risk,
    last_checked: new Date().toISOString(),
  };
  await c.env.STATE.put(key, JSON.stringify(updated));
}

async function trackChange(
  c: Context<AppEnv>,
  url: string,
  result: PreflightResult,
): Promise<{ changed: boolean; first_observation: boolean }> {
  const fingerprint = await sha256(
    JSON.stringify({
      final_url: result.final_url,
      status: result.status,
      title: result.proof.title,
      html_length: result.proof.html_length,
      checks: result.checks,
    }),
  );
  const key = `change:${await sha256(url)}`;
  const previous = await c.env.STATE.get(key);
  c.executionCtx.waitUntil(c.env.STATE.put(key, fingerprint));
  c.executionCtx.waitUntil(recordSiteIntel(c, url, result));
  return {
    changed: previous !== null && previous !== fingerprint,
    first_observation: previous === null,
  };
}

