    { path: "/openapi.json", expectedStatus: 200 },
    { path: "/.well-known/x402.json", expectedStatus: 200 },
    {
      path: "/v1/preflight?url=https://example.com&intent=healthcheck",
      expectedStatus: 402,
      expectedPrice: standardRoute.price,
    },
    {
      path: "/v1/premium-preflight?url=https://example.com&intent=healthcheck",
      expectedStatus: 402,
      expectedPrice: premiumRoute.price,
    },
  ];

  const results = await Promise.all(
    checks.map(async (check) => {
      const response = await fetch(`${env.PUBLIC_BASE_URL}${check.path}`, {
        headers: { Accept: "application/json" },
        signal: AbortSignal.timeout(FETCH_TIMEOUT_MS),
      });
      const body = await readBoundedText(response, 128_000);
      const correctPayment =
        check.expectedStatus !== 402 ||
        (body.includes(check.expectedPrice ?? "") &&
          body.includes(env.X402_PAY_TO) &&
          body.includes(env.X402_NETWORK) &&
          body.includes(env.X402_ASSET) &&
          response.headers.has("PAYMENT-REQUIRED"));
      return {
        path: check.path,
