      a >= 224
    ) {
      return false;
    }
  }
  if (
    host.startsWith("fc") ||
    host.startsWith("fd") ||
    host.startsWith("fe8") ||
    host.startsWith("fe9") ||
    host.startsWith("fea") ||
    host.startsWith("feb")
  ) {
    return false;
  }
  return true;
}

function extractTitle(html: string): string | null {
  const match = html.match(/<title[^>]*>([\s\S]*?)<\/title>/i);
  return match ? decodeBasicEntities(match[1].replace(/\s+/g, " ").trim()).slice(0, 300) : null;
}

function extractPrice(html: string): string | null {
  const structured = html.match(
    /(?:itemprop=["']price["'][^>]*content=["']|["']price["']\s*:\s*["'])(\d+(?:\.\d{1,2})?)/i,
  );
  if (structured) return `$${structured[1]}`;
  const visible = html.match(/(?:US\$|\$)\s?(\d{1,6}(?:,\d{3})*(?:\.\d{2})?)/);
  return visible ? `$${visible[1]}` : null;
}

function decodeBasicEntities(value: string): string {
  return value
    .replace(/&amp;/gi, "&")
    .replace(/&lt;/gi, "<")
    .replace(/&gt;/gi, ">")
    .replace(/&quot;/gi, "\"")
    .replace(/&#39;/gi, "'");
}

function isRedirect(status: number): boolean {
  return status === 301 || status === 302 || status === 303 || status === 307 || status === 308;
}

function highestRisk(risks: Array<"low" | "medium" | "high">): "low" | "medium" | "high" {
  if (risks.includes("high")) return "high";
  if (risks.includes("medium")) return "medium";
  return "low";
}

async function sha256(value: string): Promise<string> {
  const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(value));
  return [...new Uint8Array(digest)].map((byte) => byte.toString(16).padStart(2, "0")).join("");
}

function delay(ms: number): Promise<void> {
  return new Promise((resolve) => setTimeout(resolve, ms));
}

function errorCode(error: unknown): string {
  if (error instanceof Error) return error.message.split(":")[0] || "UNKNOWN_ERROR";
  return "UNKNOWN_ERROR";
}

function stringOrUndefined(value: unknown): string | undefined {
  return typeof value === "string" ? value : undefined;
}

function booleanOrUndefined(value: unknown): boolean | undefined {
  return typeof value === "boolean" ? value : undefined;
}

function safeJson(value: string): unknown {
  try {
    return JSON.parse(value);
  } catch {
    return value;
  }
}

function mcpError(
  id: string | number | null,
  code: number,
  message: string,
): Record<string, unknown> {
  return { jsonrpc: "2.0", id, error: { code, message } };
}

function renderDocs(): string {
  const rows = ROUTES.map(
    (route) =>
      `<tr><td><code>${route.method}</code></td><td><code>${routeExample(route)}</code></td><td>${route.title}</td><td><strong>${route.price}</strong></td></tr>`,
  ).join("");
  return `<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>${SERVICE.name}</title>
<style>
body{font-family:system-ui,sans-serif;max-width:1000px;margin:48px auto;padding:0 20px;background:#07111f;color:#e8f0ff}
h1{color:#54e38e}a{color:#6ed0ff}table{width:100%;border-collapse:collapse;background:#0e1b2d}
th,td{text-align:left;padding:14px;border-bottom:1px solid #243550}code{color:#ffd166}
.pill{display:inline-block;padding:6px 10px;border:1px solid #54e38e;border-radius:999px;color:#54e38e}
</style>
</head>
<body>
<span class="pill">x402 v2 • Base mainnet • USDC</span>
<h1>${SERVICE.name}</h1>
<p>Pre-transaction URL intelligence for autonomous agents. Every paid fulfillment returns a <code>PAYMENT-RESPONSE</code> receipt.</p>
<p><strong>GET routes must include the complete <code>?url=</code> query shown below.</strong></p>
<table><thead><tr><th>Method</th><th>Callable example</th><th>Tool</th><th>Price</th></tr></thead><tbody>${rows}</tbody></table>
<p><a href="/openapi.json">OpenAPI</a> · <a href="/mcp">MCP</a> · <a href="/SKILL.md">Skill</a> · <a href="/.well-known/x402.json">x402 discovery</a></p>
</body>
</html>`;
}

export default {
  fetch: app.fetch,
  async scheduled(_controller: ScheduledController, env: Env, ctx: ExecutionContext): Promise<void> {
    ctx.waitUntil(runHourlyHealthcheck(env));
  },
};
